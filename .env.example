# ============================================================
# GeoAgri AI — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- General ----------
NODE_ENV=development

# ---------- Backend (Node.js / Fastify) ----------
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
# Public URL of the frontend (used in email links & CORS)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# JWT — use long random strings in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Database (SQLite via Prisma) ----------
# Swap for postgresql://user:pass@host:5432/geoagri to migrate to PostgreSQL
DATABASE_URL=file:../database/geoagri.db

# ---------- Python GIS Service ----------
# Use 127.0.0.1 rather than localhost (Node 18 fetch prefers IPv6 ::1)
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_PORT=8000
# Shared secret between backend and python-service
GIS_SERVICE_API_KEY=change-me-internal-key

# Google Earth Engine service account (leave blank to run in synthetic
# data mode — useful for local development without GEE access)
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_FILE=/app/credentials/gee-service-account.json

# ---------- Weather (Open-Meteo, no API key required) ----------
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST empty to log emails to the console (development mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GeoAgri AI <no-reply@geoagri.ai>"

# ---------- File storage ----------
UPLOADS_DIR=../database/uploads
REPORTS_DIR=../database/reports
NDVI_DIR=../database/ndvi
MAX_UPLOAD_MB=10

# ---------- Rate limiting ----------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
